# CampusQ Backend Environment Variables Template
# Copy this file to .env (or configure in your hosting platform) and replace placeholders with real values.
# NEVER commit real secrets or .env files to version control.

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL 8 Database
DB_URL=jdbc:mysql://localhost:3306/campusq_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USERNAME=campusq_user
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# JPA (use 'update' in dev, 'validate' in prod once schema is in place)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# JWT Secret (Base64-encoded random key of at least 32 bytes / 256 bits)
# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_256_BIT_SECRET
JWT_EXPIRATION_MS=86400000

# Super Admin Bootstrap (used once at startup if account does not exist)
CAMPUSQ_SUPER_ADMIN_EMAIL=superadmin@campusq.edu
CAMPUSQ_SUPER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_SUPER_ADMIN_PASSWORD

# CORS Allowed Origins (comma-separated, no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Logging Levels
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_SECURITY=INFO
